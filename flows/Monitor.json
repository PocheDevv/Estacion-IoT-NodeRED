    {
        "id": "mon_func_host",
        "type": "function",
        "z": "mon_tab_001",
        "name": "Parsear datos host",
        "func": "var host = msg.payload.host || {};\nvar drive = msg.payload.drive || {};\nvar cpu = msg.payload.cpu || {};\nvar memory = msg.payload.memory || {};\n\nvar cpuTemp = 0;\nif (cpu.cpu_temp) {\n    cpuTemp = parseFloat(cpu.cpu_temp.replace('temp=','').replace(\"'C\",\"\")) || 0;\n}\n\nvar diskUsage = 0;\nif (drive.disk_usage) {\n    diskUsage = parseFloat(drive.disk_usage.replace('%','')) || 0;\n}\n\nvar cpuUsage = parseFloat(cpu.cpu_usage) || 0;\nvar memUsage = memory.mem_usage || 0;\n\nreturn [\n    [{payload: host.hostname || '---'}],\n    [{payload: host.address || '---'}],\n    [{payload: host.time || '---'}],\n    [{payload: drive.disk_total || '---'}],\n    [{payload: drive.disk_available || '---'}],\n    [{payload: drive.disk_used || '---'}],\n    [{payload: drive.disk_usage || '---'}],\n    [{payload: diskUsage}],\n    [{payload: cpuUsage, topic: 'CPU'}],\n    [{payload: cpuTemp, topic: 'TEMP CPU'}],\n    [{payload: memUsage, topic: 'RAM'}]\n];",
        "outputs": 11,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 260,
        "wires": [
            [
                "mon_txt_hn"
            ],
            [
                "mon_txt_ip"
            ],
            [
                "mon_txt_fecha"
            ],
            [
                "mon_txt_cap"
            ],
