    {
        "id": "ctl_func_r1",
        "type": "function",
        "z": "ctl_tab_001",
        "name": "Cmd Relay 1",
        "func": "var estado = msg.payload;\nmsg.payload = {key: 'relay', id: '1', value: estado};\n\n// Registrar operacion\nvar ops = flow.get('operaciones') || [];\nvar now = new Date();\nvar fecha = now.toLocaleDateString('es-PE') + ' ' + now.toLocaleTimeString('es-PE');\nops.unshift({fecha: fecha, salida: 'Relay1', valor: estado === 1 ? 'On' : 'Off'});\nif (ops.length > 20) ops.pop();\nflow.set('operaciones', ops);\n\nnode.send([msg, {payload: ops}]);\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "ctl_mqtt_out"
            ],
            [
                "ctl_tabla_ops"
            ]
        ]
