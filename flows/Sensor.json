    {
        "id": "sen_func_parse",
        "type": "function",
        "z": "sen_tab_001",
        "name": "Parsear sensores",
        "func": "var p = msg.payload;\n\nvar temp = p.temperatureC || 0;\nvar hum = p.humidity || 0;\nvar lux = p.luminousIntensity || 0;\nvar pres = p.atmosphericPressure || 0;\nvar elev = p.elevation || 0;\nvar uv = p.uvIntensity || 0;\nvar fecha = p.date || '';\n\n// Registro para la tabla\nvar registro = {\n    fecha: fecha,\n    temperatura: temp,\n    humedad: hum,\n    luminosidad: lux,\n    presion: pres,\n    uv: uv\n};\n\n// Acumular en contexto para la tabla (max 50 registros)\nvar tabla = context.get('tabla') || [];\ntabla.unshift(registro);\nif (tabla.length > 50) tabla.pop();\ncontext.set('tabla', tabla);\n\nreturn [\n    [{payload: pres + ' hPa'}],\n    [{payload: elev.toFixed(2) + ' msnm'}],\n    [{payload: uv}],\n    [{payload: hum, topic: 'Humedad'}],\n    [{payload: temp, topic: 'Temperatura'}],\n    [{payload: lux, topic: 'Luminosidad'}],\n    [{payload: tabla}]\n];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "sen_txt_pres"
            ],
            [
                "sen_txt_elev"
            ],
            [
                "sen_uv_texto"
            ],
            [
                "sen_gauge_hum",
                "sen_chart_ht"
            ],
            [
                "sen_gauge_temp",
                "sen_chart_ht"
            ],
            [
                "sen_gauge_lux",
                "sen_chart_lux"
            ],
            [
                "sen_tabla"
            ]
        ]
    },
